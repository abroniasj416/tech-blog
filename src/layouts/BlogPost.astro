---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { formatPostDate } from '../lib/blog';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, category, tags = [] } = Astro.props;
---

<!doctype html>
<html lang="ko-KR">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
	</head>

	<body>
		<Header />
		<main class="post-page">
			<article>
				<header class="post-header">
					<h1>{title}</h1>
					<p class="post-date">
						<span aria-hidden="true">▣</span>
						<time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
						{updatedDate && <span>Updated {formatPostDate(updatedDate)}</span>}
					</p>
					<p class="post-description">{description}</p>
					{
						(category || tags.length > 0) && (
							<ul class="post-taxonomy" aria-label="분류와 태그">
								{category && <li>{category}</li>}
								{tags.map((tag) => (
									<li>#{tag}</li>
								))}
							</ul>
						)
					}
				</header>
				<div class="post-content">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-page {
		max-width: var(--content-max);
	}

	.post-header {
		margin-bottom: 2.5rem;
	}

	.post-header h1 {
		color: var(--color-accent);
		font-size: clamp(1.75rem, 4vw, 2.7rem);
		line-height: 1.28;
	}

	.post-date {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.6rem;
		margin-top: 0.55rem;
		color: var(--color-subtle);
		font-size: 0.82rem;
	}

	.post-description {
		margin-top: 0.9rem;
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1.75;
	}

	.post-taxonomy {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--color-muted);
		font-size: 0.88rem;
	}

	.post-content {
		font-size: 1rem;
		line-height: 1.9;
	}

	.post-content :global(h2) {
		margin-top: 2.4rem;
		margin-bottom: 0.8rem;
		font-size: 1.6rem;
	}

	.post-content :global(h3) {
		margin-top: 2rem;
		margin-bottom: 0.7rem;
		font-size: 1.25rem;
	}

	.post-content :global(p),
	.post-content :global(ul),
	.post-content :global(ol) {
		margin: 1rem 0 0;
	}

	.post-content :global(ul),
	.post-content :global(ol) {
		padding-left: 1.35rem;
	}

	.post-content :global(li + li) {
		margin-top: 0.3rem;
	}

	.post-content :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.post-content :global(img) {
		display: block;
		margin: 1.8rem auto;
	}
</style>
