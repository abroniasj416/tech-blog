---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import SiteSidebar from '../../components/SiteSidebar.astro';
import { SITE_TITLE } from '../../consts';
import { sortPostsByDate } from '../../lib/blog';

const posts = sortPostsByDate(await getCollection('blog'));
---

<!doctype html>
<html lang="ko-KR">
	<head>
		<BaseHead title={`Posts | ${SITE_TITLE}`} description="황수진의 Cloud & Infra Notes 전체 게시글 목록입니다." />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-grid">
				<SiteSidebar posts={posts} />
				<section aria-labelledby="all-posts">
					<h1 id="all-posts" class="section-title">Posts</h1>
					<PostList posts={posts} />
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
