---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProfileMark from '../components/ProfileMark.astro';
import { GITHUB_URL, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko-KR">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="황수진의 관심 분야와 기술 블로그 소개입니다." />
	</head>
	<body>
		<Header />
		<main class="about-page">
			<ProfileMark />
			<h1>안녕하세요, 황수진입니다.</h1>
			<p class="intro">
				클라우드 환경을 운영하고 기술을 학습하며, 이해한 내용을 다시 설명할 수 있을 때까지
				기록합니다.
			</p>

			<section>
				<h2>Interests</h2>
				<ul>
					<li>NAVER Cloud Platform</li>
					<li>Linux</li>
					<li>Network</li>
					<li>Docker</li>
					<li>Kubernetes</li>
					<li>Security</li>
					<li>Database</li>
					<li>DevOps Automation</li>
				</ul>
			</section>

			<section>
				<h2>Profile</h2>
				<dl>
					<div>
						<dt>Location</dt>
						<dd>Seoul, Korea</dd>
					</div>
					<div>
						<dt>GitHub</dt>
						<dd><a href={GITHUB_URL} target="_blank" rel="noreferrer">{GITHUB_URL}</a></dd>
					</div>
					<div>
						<dt>Blog</dt>
						<dd><a href="https://blog.hwangsoojin.cloud">https://blog.hwangsoojin.cloud</a></dd>
					</div>
				</dl>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page {
		max-width: 720px;
	}

	.about-page h1 {
		margin-top: 0.8rem;
		font-size: clamp(1.7rem, 4vw, 2.4rem);
	}

	.intro {
		margin-top: 1rem;
		color: var(--color-muted);
		font-size: 1.05rem;
		line-height: 1.9;
	}

	section {
		margin-top: 3rem;
	}

	h2 {
		margin-bottom: 1rem;
		font-size: 1.25rem;
	}

	ul {
		display: grid;
		gap: 0.55rem;
		margin: 0;
		padding-left: 1.2rem;
	}

	dl {
		display: grid;
		gap: 0.75rem;
		margin: 0;
	}

	dl div {
		display: grid;
		grid-template-columns: 100px 1fr;
		gap: 1rem;
	}

	dt {
		color: var(--color-subtle);
		font-weight: 800;
	}

	dd {
		margin: 0;
		color: var(--color-muted);
	}

	@media (max-width: 560px) {
		dl div {
			grid-template-columns: 1fr;
			gap: 0.1rem;
		}
	}
</style>
