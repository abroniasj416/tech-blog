---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import SiteSidebar from '../components/SiteSidebar.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { sortPostsByDate } from '../lib/blog';

const posts = sortPostsByDate(await getCollection('blog'));
const recentPosts = posts.slice(0, 20);
---

<!doctype html>
<html lang="ko-KR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-grid">
				<SiteSidebar posts={posts} />
				<section aria-labelledby="recent-posts">
					<h1 id="recent-posts" class="section-title">Recent posts</h1>
					<PostList posts={recentPosts} />
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
