---
import { GITHUB_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
	<nav class="header-inner" aria-label="주요 메뉴">
		<a class="site-brand" href={`${basePath}/`}>{SITE_TITLE}</a>
		<div class="site-nav">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
			<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		background: var(--color-bg);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: min(100% - 2rem, var(--layout-max));
		margin: 0 auto;
		padding: 1.7rem 0;
	}

	.site-brand {
		color: #111111;
		font-size: clamp(1.35rem, 3vw, 1.8rem);
		font-style: italic;
		font-weight: 900;
		letter-spacing: -0.04em;
		white-space: nowrap;
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: clamp(1.2rem, 4vw, 2.5rem);
		font-size: clamp(0.95rem, 2.4vw, 1.15rem);
		font-weight: 800;
		white-space: nowrap;
	}

	.site-nav a.active,
	.site-nav a:hover,
	.site-nav a:focus-visible {
		color: var(--color-accent);
	}

	@media (max-width: 560px) {
		.header-inner {
			width: min(100% - 1.25rem, var(--layout-max));
			padding: 1.25rem 0;
		}

		.site-brand {
			font-size: 1.15rem;
		}

		.site-nav {
			gap: 0.85rem;
			font-size: 0.9rem;
		}
	}
</style>
