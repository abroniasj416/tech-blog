---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(basePath, '') || '/';
const subpath = pathname.match(/[^\/]+/g);
const normalizePath = (value: unknown) =>
	typeof value === 'string' && value !== '/' ? value.replace(/\/$/, '') : value;
const isActive =
	normalizePath(href) === normalizePath(pathname) ||
	normalizePath(href) === normalizePath('/' + (subpath?.[0] || ''));
const resolvedHref =
	typeof href === 'string' && href.startsWith('/')
		? `${basePath}${href === '/' ? '/' : href}`
		: href;
---

<a href={resolvedHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: 800;
	}
</style>
