---
import type { BlogPost } from '../lib/blog';
import { getCategoryCounts } from '../lib/blog';

interface Props {
	posts: BlogPost[];
	activeCategory?: string;
}

const { posts, activeCategory } = Astro.props;
const categories = getCategoryCounts(posts);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="category-nav" aria-label="카테고리">
	<a class="category-link category-all" href={`${basePath}/blog/`} aria-current={!activeCategory ? 'page' : undefined}>
		<span>분류 전체보기</span>
		<span class="category-count"><span class="sr-only">글 </span>({posts.length})</span>
	</a>
	{
		categories.map((category) => (
			<a class:list={['category-link', { active: activeCategory === category.name }]} href={category.href} aria-current={activeCategory === category.name ? 'page' : undefined}>
				<span class="category-name"><span class="category-arrow" aria-hidden="true">↘</span>{category.name}</span>
				<span class="category-count"><span class="sr-only">글 </span>({category.count})</span>
			</a>
		))
	}
</nav>

<style>
	.category-nav {
		border-top: 2px solid #666666;
		border-bottom: 1px solid #b8b8b8;
		background: #f8f8f8;
		font-weight: 400;
	}

	.category-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		min-height: 35px;
		padding: 7px 6px;
		border-bottom: 1px dashed #e3e3e3;
		color: #888888;
		font-size: 12px;
		line-height: 1.6;
	}

	.category-link:last-child {
		border-bottom: 0;
	}

	.category-all {
		border-bottom: 1px solid #aaaaaa;
		color: #555555;
	}

	.category-name {
		display: flex;
		align-items: baseline;
		gap: 10px;
		min-width: 0;
	}

	.category-arrow {
		flex-shrink: 0;
		font-size: 13px;
		font-weight: 300;
	}

	.category-count {
		flex-shrink: 0;
		color: #f36b21;
		font-size: 11px;
		font-variant-numeric: tabular-nums;
	}

	.category-link.active,
	.category-link:hover,
	.category-link:focus-visible {
		color: #78a6da;
	}
</style>
