---
import { Image } from 'astro:assets';
import profileImage from '../assets/profile.webp';
---

<Image
	class="profile-image"
	src={profileImage}
	alt="황수진 프로필 — 노란 배경의 초록색 도마뱀 캐릭터"
	width={164}
	height={164}
/>

<style>
	.profile-image {
		display: block;
		width: 82px;
		height: 82px;
		margin: 0 auto 2rem;
		object-fit: contain;
	}
</style>
